# Keep the build context small and the builds reproducible: dependencies
# and build outputs are created inside the image, never copied from the host.
.git
.github
**/.DS_Store
**/.idea
**/.vscode

# Frontend
frontend/node_modules
frontend/dist
frontend/coverage
frontend/.vite

# Backend
backend/server
backend/bin
**/*.out

# Docs and local files
docs
*.md
.env
.env.*
